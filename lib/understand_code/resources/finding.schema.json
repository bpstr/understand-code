            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,159}$"
          },
          "kind": {
            "enum": [
              "system",
              "module",
              "feature",
              "flow",
              "entrypoint",
              "ui_surface",
              "component",
              "setting",
              "feature_flag",
              "data_entity",
              "external_system",
              "event",
              "job",
              "permission",
              "test_behavior",
              "decision",
              "constraint",
              "knowledge_gap",
              "concept",
              "occurrence"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "confidence": {
            "type": "string",
            "enum": [
              "EXTRACTED",
              "CORROBORATED",
              "INFERRED",
              "UNKNOWN"
            ]
          },
          "evidence": {
            "type": "array",
