{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bpstr/understand-code/schemas/finding.schema.json",
  "title": "finding",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "snapshot",
    "entities",
    "relations",
    "evidence",
    "gaps",
    "review"
