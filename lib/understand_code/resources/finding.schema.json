              "$id": "https://github.com/bpstr/understand-code/schemas/code-reference.schema.json",
              "title": "code-reference",
              "type": "object",
              "properties": {
                "repository": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{0,159}$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "anchor": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "start_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "end_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "producer_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
