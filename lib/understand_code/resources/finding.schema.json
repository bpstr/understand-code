                              "analysis",
                              "demonstration",
                              "unresolved"
                            ]
                          },
                          "procedure": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 12000
                          },
                          "expected": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 12000
                          },
                          "test_evidence": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 160,
                              "pattern": "^[a-z][a-z0-9_.-]{0,159}$"
                            },
                            "minItems": 0,
                            "maxItems": 128,
                            "uniqueItems": true
                          }
                        },
                        "required": [
                          "method",
                          "procedure",
                          "expected",
                          "test_evidence"
                        ],
                        "additionalProperties": false
                      },
                      "origin": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 12000
                      }
                    },
                    "required": [
                      "id",
                      "statement",
                      "basis",
                      "rationale",
                      "evidence",
                      "verification"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0,
                  "maxItems": 128
                },
                "examples": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160,
                        "pattern": "^[a-z][a-z0-9_.-]{0,159}$"
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "kind": {
                        "enum": [
                          "runnable",
                          "illustrative"
                        ]
                      },
                      "language": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[A-Za-z0-9_+-]+$"
                      },
                      "code": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 32768
                      },
                      "prerequisites": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 12000
                      },
                      "expected": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 12000
                      },
                      "evidence": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160,
                          "pattern": "^[a-z][a-z0-9_.-]{0,159}$"
                        },
                        "minItems": 0,
                        "maxItems": 128,
                        "uniqueItems": true
                      },
                      "validation": {
                        "type": "object",
                        "properties": {
                          "status": {
                            "enum": [
                              "not-run",
                              "passed",
                              "failed"
                            ]
                          },
                          "level": {
                            "enum": [
                              "none",
                              "syntax",
                              "schema",
                              "behavior"
                            ]
                          },
                          "reason": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 12000
                          },
                          "provenance": {
                            "type": "object",
                            "properties": {
                              "command": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 12000
                              },
                              "environment": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 12000
                              },
                              "snapshot": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 64,
                                "pattern": "^[a-f0-9]{64}$"
                              },
                              "checked_at": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 64
                              },
                              "runner": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 512
                              },
                              "output_sha256": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 64,
                                "pattern": "^[a-f0-9]{64}$"
                              },
                              "example_sha256": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 64,
                                "pattern": "^[a-f0-9]{64}$"
