                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "profile": {
                  "enum": [
                    "reference",
                    "how-to",
                    "tutorial",
                    "explanation",
                    "specification"
                  ]
                },
                "mode": {
                  "enum": [
                    "as-built",
                    "proposal",
                    "mixed"
                  ]
                },
                "audience": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "scope": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "sections": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160,
                        "pattern": "^[a-z][a-z0-9_.-]{0,159}$"
                      },
                      "topic": {
                        "enum": [
                          "context",
                          "design",
                          "tradeoffs",
                          "prerequisites",
                          "steps",
                          "verification",
                          "troubleshooting",
                          "inputs",
                          "outputs",
                          "errors",
                          "side-effects",
                          "behavior",
                          "interfaces",
                          "data",
                          "failures",
                          "security",
                          "quality",
                          "compatibility",
                          "operations",
                          "decisions",
                          "constraints"
                        ]
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "status": {
                        "enum": [
                          "documented",
                          "unknown",
                          "not-applicable"
                        ]
                      },
                      "content": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 12000
                      },
                      "evidence": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160,
                          "pattern": "^[a-z][a-z0-9_.-]{0,159}$"
