          "commit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "kind": {
            "enum": [
              "source",
              "test",
              "config",
              "documentation",
              "human"
            ]
          }
        },
        "additionalProperties": false
      },
      "maxItems": 500
