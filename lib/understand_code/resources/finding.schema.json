                            "additionalProperties": false
                          }
                        },
                        "required": [
                          "status",
                          "level",
                          "reason"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "id",
                      "title",
                      "kind",
                      "language",
                      "code",
                      "prerequisites",
                      "expected",
                      "evidence",
                      "validation"
                    ],
                    "additionalProperties": false
