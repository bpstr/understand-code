                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            },
                            "minItems": 1,
                            "maxItems": 8
                          },
                          "rows": {
                            "type": "array",
                            "items": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 2048
                              },
                              "minItems": 1,
                              "maxItems": 8
                            },
                            "minItems": 1,
                            "maxItems": 128
                          }
                        },
                        "required": [
                          "columns",
                          "rows"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "id",
                      "topic",
                      "title",
                      "status",
                      "content",
                      "evidence"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0,
                  "maxItems": 32
                },
                "requirements": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160,
                        "pattern": "^req\\.[a-z0-9][a-z0-9_.-]{0,154}$"
